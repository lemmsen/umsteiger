# Umsteiger on the Raspberry Pi. Caddy gets and renews the Let's Encrypt certificate by itself;
# it needs ports 80 and 443 reachable from the internet for that.
# Copy this file to deploy/Caddyfile (not in Git) and put in your own names.

(umsteiger) {
	encode zstd gzip
	root * /srv/umsteiger/app

	# live data: answered by server.py (umsteiger.service)
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# the app itself: static files
	handle {
		file_server
	}
}

umsteiger.example.org {
	import umsteiger
}

# Fallback inside the home network when the DynDNS name does not resolve: plain http, so no
# offline mode and no location search there.
http://192.168.1.10, http://raspberrypi.local {
	import umsteiger
}
